{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/ey-parthenon",
      "destination": "/ey-parthenon/index.html"
    },
    {
      "source": "/ey-parthenon/:path*",
      "destination": "/ey-parthenon/:path*"
    },
    {
      "source": "/snowflake",
      "destination": "/snowflake/index.html"
    },
    {
      "source": "/snowflake/:path*",
      "destination": "/snowflake/:path*"
    }
  ]
}
